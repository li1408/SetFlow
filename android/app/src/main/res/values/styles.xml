<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColorPrimary">@color/setflow_text</item>
        <item name="android:textColorSecondary">@color/setflow_muted</item>
        <item name="android:colorBackground">@color/setflow_canvas</item>
        <item name="android:popupBackground">@color/setflow_surface_raised</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/setflow_canvas</item>
        <item name="android:windowBackground">@color/setflow_canvas</item>
        <item name="android:colorBackground">@color/setflow_canvas</item>
        <item name="android:navigationBarColor">@color/setflow_canvas</item>
        <item name="android:statusBarColor">@color/setflow_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColorPrimary">@color/setflow_text</item>
        <item name="android:textColorSecondary">@color/setflow_muted</item>
        <item name="android:popupBackground">@color/setflow_surface_raised</item>
        <item name="colorControlNormal">@color/setflow_border</item>
        <item name="colorControlActivated">@color/colorAccent</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/setflow_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_setflow_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
